#!/bin/bash
# Thin launcher installed to /usr/bin/dash-phonecon by the .deb package.
#
# Self-healing: tries the system python3 first (fast path, used when
# python3-pyside6.* was actually available and installed via apt). If the
# system interpreter can't import PySide6/websockets (e.g. postinst had to
# fall back to a private virtualenv because this distro's archives don't
# ship python3-pyside6.*), transparently re-execs using that virtualenv's
# interpreter instead. Either way the user just runs `dash-phonecon`.
set -e

VENV_PYTHON="/usr/lib/dash-phonecon/venv/bin/python3"

if python3 -c "import PySide6, websockets" >/dev/null 2>&1; then
    exec python3 -c "import sys; from dashphone.app import main; sys.exit(main())" "$@"
fi

if [ -x "$VENV_PYTHON" ] && "$VENV_PYTHON" -c "import PySide6, websockets" >/dev/null 2>&1; then
    # The dashphone app package itself lives in the system site-packages
    # (installed by the .deb, not pip), so the venv still needs to find it.
    # Deliberately NOT using PYTHONPATH here: PYTHONPATH entries are inserted
    # ahead of the venv's own site-packages on sys.path, so an older
    # apt-installed package of the same name (e.g. python3-websockets 10.4,
    # missing the newer `websockets.asyncio` API) would shadow the venv's
    # newer pip-installed one (found the hard way - the app crashed with
    # ModuleNotFoundError: websockets.asyncio despite the venv having a
    # working install). sys.path.append() keeps the venv's own packages
    # authoritative and only adds dist-packages as a fallback lookup.
    exec "$VENV_PYTHON" \
        -c "import sys; sys.path.append('/usr/lib/python3/dist-packages'); from dashphone.app import main; sys.exit(main())" "$@"
fi

echo "dash-phonecon: required dependencies (PySide6, websockets) are missing" >&2
echo "and no working environment was found. Try:" >&2
echo "  sudo apt install --reinstall dash-phonecon" >&2
echo "or, if that doesn't help (no network during install):" >&2
echo "  sudo /usr/lib/dash-phonecon/venv/bin/pip install PySide6 websockets" >&2
exit 1

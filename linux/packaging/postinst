#!/bin/bash
# Self-healing post-install: makes sure PySide6/websockets are actually
# importable no matter which Ubuntu/Debian release this lands on.
#
# python3-pyside6.* is only a Recommends (see packaging/control.in) because
# it doesn't exist at all in some distro archives (e.g. Ubuntu 24.04
# "noble" - see AGENTS.md). apt installs Recommends by default when
# available, so on most systems this whole fallback is a no-op. When it's
# NOT available (or Recommends were skipped with --no-install-recommends),
# this script builds a private virtualenv with the same packages from PyPI
# so the app still runs out of the box - no manual steps for the user.
set -e

VENV_DIR="/usr/lib/dash-phonecon/venv"

# Refresh desktop/icon caches so the new app-menu entry and icon show up
# immediately, without needing to log out and back in. Best-effort: harmless
# if the tools happen not to be installed.
if command -v update-desktop-database >/dev/null 2>&1; then
    update-desktop-database -q /usr/share/applications || true
fi

if command -v gtk-update-icon-cache >/dev/null 2>&1; then
    gtk-update-icon-cache -q -t -f /usr/share/icons/hicolor || true
fi

echo "dash-phonecon: checking dependencies..."

if python3 -c "import PySide6, websockets" >/dev/null 2>&1; then
    echo "dash-phonecon: PySide6 + websockets already available via system python3. Good to go."
    exit 0
fi

echo "dash-phonecon: PySide6/websockets not available from apt on this system."
echo "dash-phonecon: setting up a private virtual environment with pip instead (self-healing install)..."

if ! command -v python3 >/dev/null 2>&1; then
    echo "dash-phonecon: python3 not found - cannot continue. Install python3 and re-run: sudo apt install --reinstall dash-phonecon" >&2
    exit 0
fi

if ! python3 -m venv --help >/dev/null 2>&1; then
    echo "dash-phonecon: python3-venv module missing; attempting to install it..."
    apt-get install -y python3-venv >/dev/null 2>&1 || true
fi

if python3 -m venv --help >/dev/null 2>&1; then
    rm -rf "$VENV_DIR"
    if python3 -m venv "$VENV_DIR" 2>/dev/null; then
        echo "dash-phonecon: installing PySide6 + websockets into ${VENV_DIR} (this can take a minute)..."
        if "${VENV_DIR}/bin/pip" install --quiet --upgrade pip >/dev/null 2>&1 \
           && "${VENV_DIR}/bin/pip" install --quiet PySide6 websockets; then
            echo "dash-phonecon: dependencies installed into a private virtualenv successfully."
        else
            echo "dash-phonecon: pip install into the virtualenv failed (likely no network access right now)." >&2
            echo "dash-phonecon: the app will retry using system packages; you can also run:" >&2
            echo "  sudo ${VENV_DIR}/bin/pip install PySide6 websockets" >&2
            echo "dash-phonecon: once your network is back to finish setup." >&2
        fi
    else
        echo "dash-phonecon: could not create a virtualenv at ${VENV_DIR}." >&2
    fi
else
    echo "dash-phonecon: python3-venv unavailable and could not be installed automatically." >&2
    echo "dash-phonecon: run manually: sudo apt install python3-venv, then: sudo apt install --reinstall dash-phonecon" >&2
fi

exit 0
